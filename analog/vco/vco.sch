C {gnd.sym} 10 20 0 0 {name=l3 lab=GND}
C {lab_pin.sym} 1550 -80 2 0 {name=p1 sig_type=std_logic lab=Vbiasp}
C {lab_pin.sym} 1550 170 2 0 {name=p2 sig_type=std_logic lab=Vbiasn}
C {symbols/ppolyf_u.sym} 130 -120 0 0 {name=R1
W=1u
L=189u
model=ppolyf_u
spiceprefix=X
m=1}
C {gnd.sym} 70 -120 0 0 {name=l4 lab=GND}
C {code_shown.sym} 550 320 0 0 {name=vctrl_domain_sweep only_toplevel=false value=".include /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.ic v(n0)=0 v(n1)=3.3 v(n2)=0 v(n3)=3.3 v(n4)=0
.control
dc V2 0 3.3 0.01
plot v(vbiasn) v(vbiasp) xlabel Vctrl ylabel Volts title Bias_voltages
setplot new
set results = $curplot
let vc = vector(21)*0.1
let f = vector(21)*0
let i = 0
while i < 21
  let vnow = vc[i]
  alter V2 dc = $&vnow
  tran 100p 1.6u 0 100p
  set runplot = $curplot
  meas tran t1 when v(n0)=1.65 rise=8
  meas tran t2 when v(n0)=1.65 rise=28
  let fnow = 20/(t2-t1)/1e6
  set fval = $&fnow
  setplot $results
  let f[i] = $fval
  destroy $runplot
  let i = i + 1
end
print vc f
plot f vs vc xlabel Vctrl ylabel MHz title VCO_frequency
alter V2 dc = 1
alter C6 = 5f
tran 20p 540n 0 20p
let n4in = v(n4)
let v5f = v(vout)
set p5 = $curplot
alter C6 = 10f
tran 20p 540n 0 20p
let v10f = v(vout)
set p10 = $curplot
alter C6 = 15f
tran 20p 540n 0 20p
let v15f = v(vout)
set p15 = $curplot
plot \{$p5\}.n4in \{$p5\}.v5f \{$p10\}.v10f \{$p15\}.v15f xlimit 500n 540n title C6_sweep
plot v(n0) v(n1) v(n2) xlimit 500n 540n xlabel Time ylabel Volts title Ring_nodes
alter C6 = 20f
.endc
"
}
